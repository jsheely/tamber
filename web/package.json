{
  "name": "@tamber/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tamber web app: mobile-first PWA for streaming Kokoro TTS with word-by-word highlighting (iOS Safari safe, no MSE).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/copy-brand-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-brand-assets.mjs",
    "build": "node scripts/tsc.mjs -b && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/tsc.mjs -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.6.2",
    "@mantine/dropzone": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@tabler/icons-react": "^3.48.0",
    "@tamber/client": "workspace:*",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
