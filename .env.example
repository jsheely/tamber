# -----------------------------------------------------------------------------
# Tamber API configuration. Copy to `.env` (next to docker-compose / in api/ for
# local runs) and adjust. Every variable is optional; the value shown is the
# default. Read by api/tamber_api/config.py (pydantic-settings, case-insensitive,
# unknown TAMBER_* keys are logged as warnings, never fatal).
# See docs/API.md for what each limit means and docs/ARCHITECTURE.md §4 for the
# NetBird reverse-proxy deployment.
# -----------------------------------------------------------------------------

# --- Server ------------------------------------------------------------------
# Bind address and port inside the container. 8880 matches Kokoro-FastAPI so
# existing OpenAI-compatible integrations keep working.
TAMBER_HOST=0.0.0.0
TAMBER_PORT=8880
# debug | info | warning | error
TAMBER_LOG_LEVEL=info
# Path prefix when served under a sub-path (not needed for a dedicated NetBird URL).
TAMBER_ROOT_PATH=
# Comma-separated IPs/CIDRs whose X-Forwarded-For / X-Forwarded-Proto are trusted
# (passed to uvicorn --forwarded-allow-ips). "*" trusts any peer; OK when the
# container is only reachable through the reverse proxy.
TAMBER_FORWARDED_ALLOW_IPS=*

# --- Security ----------------------------------------------------------------
# Bearer key(s). Empty = auth disabled. Comma-separate to allow several keys
# (e.g. one per device) -- clients send `Authorization: Bearer <key>`.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TAMBER_API_KEY=
# Allowed CORS origins: "*" (default; safe because auth is a header, never a
# cookie), a comma-separated allow-list (e.g. https://tts.example.com,chrome-extension://<id>),
# or empty to disable CORS entirely.
TAMBER_CORS_ORIGINS=*
# Serve Swagger UI at /docs and the schema at /openapi.json (no auth on these).
TAMBER_DOCS_ENABLED=true

# --- Engine / model ----------------------------------------------------------
# kokoro = real TTS (needs torch + kokoro, see api/requirements-tts.txt)
# fake   = model-free tone generator with synthetic word timings, for client
#          development and CI (no torch needed)
TAMBER_ENGINE=kokoro
# auto | cpu | cuda | mps   (auto = cuda if available, else mps, else cpu)
TAMBER_DEVICE=auto
# Hugging Face repo that holds the Kokoro weights and voices.
TAMBER_MODEL_REPO=hexgrad/Kokoro-82M
# Enabled Kokoro languages (letter codes). a=US English, b=UK English (word
# timings), e=Spanish f=French h=Hindi i=Italian p=Brazilian Portuguese (no word
# timings in v1). j/z (Japanese/Chinese) are not supported by the default image.
# In Docker, voice files for these languages are baked in at build time (build
# arg TAMBER_LANGUAGES) -- keep the two in sync.
TAMBER_LANGUAGES=a,b
TAMBER_DEFAULT_VOICE=af_heart
# wav (recommended: iOS-safe, sample-exact gapless joins) | mp3
TAMBER_DEFAULT_FORMAT=wav
# Run one short synthesis at startup so the first real request is fast.
TAMBER_WARMUP=true
# Hugging Face cache location and offline mode. The Docker image bakes the
# model + voices into /opt/tamber/hf at build time and runs offline.
HF_HOME=/opt/tamber/hf
HF_HUB_OFFLINE=1

# --- Chunking (docs/API.md §6.3) ----------------------------------------------
TAMBER_CHUNK_TARGET_CHARS=280
TAMBER_CHUNK_MAX_CHARS=400

# --- Limits ------------------------------------------------------------------
# Max text length for /v1/tts and /v1/audio/speech, in UTF-16 code units.
TAMBER_MAX_TEXT_CHARS=100000
# Max upload size (and max `html` field size) for /v1/extract, in MB.
TAMBER_MAX_UPLOAD_MB=25
# Extracted text longer than this is truncated (truncated: true).
TAMBER_MAX_EXTRACT_CHARS=500000
# Max voices in one blend spec.
TAMBER_MAX_BLEND_VOICES=4
# Requests per minute per client (API key, else IP) on POST routes. 0 = off.
TAMBER_RATE_LIMIT_PER_MINUTE=60
# Parallel synthesis jobs (the model is shared; keep 1 on CPU).
TAMBER_MAX_CONCURRENT_SYNTH=1
# Jobs allowed to wait for a slot before new ones get 503 server_busy.
TAMBER_MAX_QUEUE=16

# --- URL extraction (/v1/extract {url}) --------------------------------------
TAMBER_EXTRACT_TIMEOUT_S=15
TAMBER_EXTRACT_MAX_DOWNLOAD_MB=10
# Allow fetching private/loopback/link-local addresses (SSRF guard off).
# Only enable if you need to read pages on your own LAN.
TAMBER_EXTRACT_ALLOW_PRIVATE=false

# --- Web UI ------------------------------------------------------------------
# Directory with the built web UI (web/dist). The image copies it to /app/web.
# Empty = don't serve a UI (API only).
TAMBER_WEB_DIR=/app/web
